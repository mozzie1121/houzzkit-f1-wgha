diff --git a/arch/arm/mach-rockchip/board.c b/arch/arm/mach-rockchip/board.c
--- a/arch/arm/mach-rockchip/board.c
+++ b/arch/arm/mach-rockchip/board.c
@@ -245,0 +246,15 @@
+int g_dnl_get_board_bcd_device_number(int gcnum)
+{
+	/*
+	 * Rockchip's vendor U-Boot identifies a DWC3 download gadget as
+	 * controller revision 0x23 plus the historical 0x0200 base.  Keep
+	 * that identity on RM01 so the legacy Windows Rockusb driver sees the
+	 * same Loader device instead of U-Boot's release-number encoding.
+	 */
+	if (of_machine_is_compatible("rockchip,rk3568-rzw03")) {
+		printf("RM01 RockUSB: vendor bcdDevice=0x0223\n");
+		return 0x0223;
+	}
+
+	return gcnum;
+}
