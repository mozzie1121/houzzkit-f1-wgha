############################################
# HAOS A/B boot script for SZZN RK3568-JL-RM01

echo "==[HAOS: RK3568-JL-RM01 boot.scr]========="
if test "${devtype}" = "usb_mass_storage"; then
    setenv devtype "usb"
fi
echo "boot devtype: ${devtype}:${devnum}"

# HAOS reserves partition 6 (hassos-bootstate) for the A/B boot counter.
part start ${devtype} ${devnum} 6 dev_env
${devtype} dev ${devnum}

setenv loadbootstate " \
    ${devtype} read ${ramdisk_addr_r} ${dev_env} 0x40; \
    env import -c ${ramdisk_addr_r} 0x8000;"
setenv storebootstate " \
    env export -c -s 0x8000 ${ramdisk_addr_r} BOOT_ORDER BOOT_A_LEFT BOOT_B_LEFT MACHINE_ID COMMERCIAL_CHANNEL CONFIG_DATA ETH_ADDR RK_SERIAL RK_SOC ethaddr 'serial#' 'cpuid#'; \
    ${devtype} write ${ramdisk_addr_r} ${dev_env} 0x40;"

run loadbootstate
test -n "${BOOT_ORDER}" || setenv BOOT_ORDER "A B"
test -n "${BOOT_A_LEFT}" || setenv BOOT_A_LEFT 3
test -n "${BOOT_B_LEFT}" || setenv BOOT_B_LEFT 3

test -n "${ETH_ADDR}" || setenv ETH_ADDR "${ethaddr}"
test -n "${RK_SERIAL}" || setenv RK_SERIAL "${serial#}"
test -n "${RK_SOC}" || setenv RK_SOC "${cpuid#}"
test -n "${MACHINE_ID}" || setenv BOOT_CONDITION "systemd.condition-first-boot=true"
test -n "${BOOT_MAC}" || setenv BOOT_MAC "gmac.macaddr=${ETH_ADDR}"
setenv bootargs_hassos "zram.enabled=1 zram.num_devices=3 rootwait systemd.machine_id=${MACHINE_ID} fsck.repair=yes ${BOOT_MAC} ${BOOT_CONDITION}"

# These partition UUIDs belong to the unmodified HAOS image's system A/B slots.
setenv bootargs_a "root=PARTUUID=8d3d53e3-6d49-4c38-8349-aff6859e82fd ro"
setenv bootargs_b "root=PARTUUID=a3ec664e-32ce-4665-95ea-7ae90ce9aa20 ro"
part number ${devtype} ${devnum} hassos-boot boot_partnum

if test -e ${devtype} ${devnum}:${boot_partnum} haos-mac-addr.txt; then
    fatload ${devtype} ${devnum}:${boot_partnum} ${ramdisk_addr_r} haos-mac-addr.txt
    env import -t ${ramdisk_addr_r} ${filesize}
    setenv BOOT_MAC "gmac.macaddr=${macaddr}"
    setenv bootargs_hassos "zram.enabled=1 zram.num_devices=3 rootwait systemd.machine_id=${MACHINE_ID} fsck.repair=yes ${BOOT_MAC} ${BOOT_CONDITION}"
fi

if test -e ${devtype} ${devnum}:${boot_partnum} haos-config.txt; then
    fatload ${devtype} ${devnum}:${boot_partnum} ${ramdisk_addr_r} haos-config.txt
    env import -t ${ramdisk_addr_r} ${filesize}
fi

# The source image's cmdline.txt is empty.  Its fileenv command is a vendor
# extension absent from upstream U-Boot, so leave cmdline empty by default.
setenv cmdline

setenv ha_version "dtbs/rk3568-jl-rm01.dtb"
if test -e ${devtype} ${devnum}:${boot_partnum} uEnv.txt; then
    fatload ${devtype} ${devnum}:${boot_partnum} ${ramdisk_addr_r} uEnv.txt
    env import -t ${ramdisk_addr_r} ${filesize}
    setenv fdtfile ${FDT}
else
    setenv fdtfile ${ha_version}
fi

echo "Loading device tree ${fdtfile}"
fatload ${devtype} ${devnum}:${boot_partnum} ${fdt_addr_r} ${fdtfile}
fdt addr ${fdt_addr_r}
fdt resize 65536
for overlay_file in ${overlays}; do
    if fatload ${devtype} ${devnum}:${boot_partnum} ${ramdisk_addr_r} overlays/${overlay_file}.dtbo; then
        fdt apply ${ramdisk_addr_r} || setenv overlay_error "true"
    fi
done
if test "${overlay_error}" = "true"; then
    fatload ${devtype} ${devnum}:${boot_partnum} ${fdt_addr_r} ${fdtfile}
fi

setenv bootargs
for BOOT_SLOT in "${BOOT_ORDER}"; do
    if test "x${bootargs}" != "x"; then
        true
    elif test "x${BOOT_SLOT}" = "xA"; then
        if test ${BOOT_A_LEFT} -gt 0; then
            setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1
            part number ${devtype} ${devnum} hassos-kernel0 kernel_partnum
            if load ${devtype} ${devnum}:${kernel_partnum} ${kernel_addr_r} Image; then
                setenv bootargs "${bootargs_hassos} ${bootargs_a} rauc.slot=A ${cmdline}"
            fi
        fi
    elif test "x${BOOT_SLOT}" = "xB"; then
        if test ${BOOT_B_LEFT} -gt 0; then
            setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1
            part number ${devtype} ${devnum} hassos-kernel1 kernel_partnum
            if load ${devtype} ${devnum}:${kernel_partnum} ${kernel_addr_r} Image; then
                setenv bootargs "${bootargs_hassos} ${bootargs_b} rauc.slot=B ${cmdline}"
            fi
        fi
    fi
done

if test -n "${bootargs}"; then
    run storebootstate
else
    setenv BOOT_A_LEFT 3
    setenv BOOT_B_LEFT 3
    run storebootstate
    reset
fi

printenv bootargs
booti ${kernel_addr_r} - ${fdt_addr_r}
reset
